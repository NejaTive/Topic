{
	email {$ACME_EMAIL}
	default_sni {$PUBLIC_HOST}
}

{$PUBLIC_HOST} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	encode gzip

	request_body {
		max_size 6MB
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle /{$S3_BUCKET}/* {
		reverse_proxy minio:9000 {
			header_up Host {http.reverse_proxy.upstream.hostport}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
