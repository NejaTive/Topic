# Скопировать на VPS в /opt/topic/.env и заполнить.
# Пароли — без символов, ломающих URL (для DATABASE_URL в compose).

HTTP_PORT=80

# Браузерный origin без trailing slash (IP или позже домен)
PUBLIC_BASE_URL=http://YOUR.VPS.IP

POSTGRES_USER=topic
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=topic

MINIO_ROOT_USER=topic-minio
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=topic-covers

# Подставляет CI при деплое; для ручного up можно latest
API_IMAGE=ghcr.io/nejative/topic-api:latest
WEB_IMAGE=ghcr.io/nejative/topic-web:latest
