{
  "$description": "Topic design tokens (light). Источник истины по значениям — этот файл + docs/stages/stage-2-brainstorm.md § Дизайн-система. Формат DTCG.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#F6F7F5", "$description": "Фон приложения" },
    "surface": {
      "$value": "#FFFFFF",
      "$description": "Карточки, инпуты, модалка"
    },
    "surface-sunken": {
      "$value": "#EDF0ED",
      "$description": "Inbox-зона, hover строк, disabled-фон"
    },
    "ink": { "$value": "#16201E", "$description": "Основной текст" },
    "muted": { "$value": "#5B6865", "$description": "Вторичный текст" },
    "subtle": {
      "$value": "#8A9693",
      "$description": "Placeholder, disabled-текст"
    },
    "line": { "$value": "#DDE3E0", "$description": "Границы, разделители" },
    "line-strong": {
      "$value": "#C3CCC8",
      "$description": "Границы инпутов, secondary-кнопка"
    },
    "accent": {
      "default": { "$value": "#0F6B5C" },
      "hover": { "$value": "#0B574B" },
      "soft": { "$value": "#E2F0EC" },
      "soft-hover": {
        "$value": "#CFE6DF",
        "$description": "Chip «Публичный» hover / pressed"
      },
      "on": { "$value": "#FFFFFF" }
    },
    "danger": {
      "default": { "$value": "#B3342B" },
      "soft": { "$value": "#FBEAE8" }
    },
    "warning": {
      "default": { "$value": "#8A5A00" },
      "soft": { "$value": "#FBF1DC" },
      "hover": {
        "$value": "#F0E0B8",
        "$description": "Main chip hover / selected"
      }
    },
    "info": {
      "default": { "$value": "#2F4A68" },
      "soft": { "$value": "#E8EEF5" },
      "hover": {
        "$value": "#D4E0EF",
        "$description": "Chip «Не в списке» hover / pressed"
      }
    },
    "rank": {
      "default": { "$value": "#16201E" },
      "top": { "$value": "#0F6B5C" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Onest", "$description": "Display + UI" },
      "mono": {
        "$value": "JetBrains Mono",
        "$description": "Только номер ранга"
      }
    }
  },
  "typography": {
    "display": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 700,
        "fontSize": 40,
        "lineHeight": 48,
        "letterSpacing": -0.8
      }
    },
    "h1": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 700,
        "fontSize": 32,
        "lineHeight": 40,
        "letterSpacing": -0.5
      }
    },
    "h2": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 600,
        "fontSize": 24,
        "lineHeight": 32,
        "letterSpacing": -0.3
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 600,
        "fontSize": 20,
        "lineHeight": 28,
        "letterSpacing": 0
      }
    },
    "title": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 600,
        "fontSize": 17,
        "lineHeight": 24,
        "letterSpacing": 0
      }
    },
    "body": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 400,
        "fontSize": 16,
        "lineHeight": 24,
        "letterSpacing": 0
      }
    },
    "body-sm": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 400,
        "fontSize": 14,
        "lineHeight": 20,
        "letterSpacing": 0
      }
    },
    "label": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 600,
        "fontSize": 15,
        "lineHeight": 20,
        "letterSpacing": 0
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 500,
        "fontSize": 12,
        "lineHeight": 16,
        "letterSpacing": 0
      }
    },
    "overline": {
      "$value": {
        "fontFamily": "Onest",
        "fontWeight": 600,
        "fontSize": 11,
        "lineHeight": 16,
        "letterSpacing": 0.66,
        "textCase": "uppercase"
      }
    },
    "rank-l": {
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontWeight": 500,
        "fontSize": 28,
        "lineHeight": 32,
        "letterSpacing": 0
      }
    },
    "rank-m": {
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontWeight": 500,
        "fontSize": 20,
        "lineHeight": 24,
        "letterSpacing": 0
      }
    },
    "rank-s": {
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontWeight": 500,
        "fontSize": 14,
        "lineHeight": 20,
        "letterSpacing": 0
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px", "$description": "Чипы, cover" },
    "md": { "$value": "8px", "$description": "Кнопки, инпуты, строки" },
    "lg": { "$value": "12px", "$description": "Карточки, модалка" }
  },
  "size": {
    "$type": "dimension",
    "control-md": { "$value": "44px" },
    "control-sm": { "$value": "32px" }
  },
  "shadow": {
    "float": {
      "$type": "shadow",
      "$value": {
        "color": "#16201E14",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "16px",
        "spread": "0px"
      },
      "$description": "Единственная тень: модалка и dragging-строка"
    }
  }
}
