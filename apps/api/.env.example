PORT=3001
DATABASE_URL=postgresql://topic:topic@localhost:5432/topic

# Prod: https://topi-ki.ru → Secure cookie; локально можно не задавать
# PUBLIC_BASE_URL=https://topi-ki.ru

# S3 / MinIO (обложки). coverUrl: abs = {S3_PUBLIC_URL}/{bucket}/{key}; "." = /{bucket}/{key}
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=topic-covers
S3_PUBLIC_URL=http://127.0.0.1:9000

# Prod (compose): S3_ENDPOINT=http://minio:9000, S3_PUBLIC_URL=. (same-origin через Caddy)
