generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TopicPrivacy {
  private
  unlisted
  public
}

enum ItemPlacement {
  unranked
  ranked
}

/// Пользователь. `nick` хранится в lowercase — unique = case-insensitive.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  nick         String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  topics       Topic[]
}

/// Opaque-сессия (tokenHash в БД; cookie с токеном — на уровне app).
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Топик владельца. `shareId` стабилен при смене privacy; ранги элементов — плотный 1…N в приложении.
model Topic {
  id        String       @id @default(uuid())
  shareId   String       @unique
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  privacy   TopicPrivacy @default(unlisted)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     Item[]

  @@index([ownerId])
}

/// Элемент топика. `coverKey` — ключ в S3/MinIO; `rankPosition` только при placement=ranked (плотный 1…N).
model Item {
  id           String        @id @default(uuid())
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title        String
  coverKey     String?
  placement    ItemPlacement
  rankPosition Int?
  createdAt    DateTime      @default(now())

  @@index([topicId, placement, rankPosition])
}
